{
  "name": "@remoteai/coze",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p ui/tsconfig.json && vite build --config ui/vite.config.ts",
    "check": "npm run check:i18n && npm run build && npm test && npm run test:scripts",
    "test": "vitest run --config scripts/vitest.config.ts",
    "test:e2e": "playwright test --config scripts/playwright.config.ts",
    "generate:i18n": "npm run generate -w @remoteai/i18n",
    "check:i18n": "npm run check -w @remoteai/i18n",
    "test:scripts": "node --test scripts/test-browser.test.mjs scripts/verify-windows-runtime.test.mjs scripts/independence.test.mjs",
    "prepare:model": "node scripts/prepare-coze-model.mjs"
  },
  "dependencies": {
    "@remoteai/i18n": "0.1.0",
    "@xyflow/react": "^12.12.0",
    "antd": "^5.29.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vitest": "^4.1.9"
  },
  "workspaces": [
    "packages/i18n"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/piperhex/remoteai-coze.git"
  },
  "engines": {
    "node": ">=20.19"
  }
}
